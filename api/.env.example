# Copy this file to api/.env and fill in the values.
# .env is gitignored — never commit secrets.

# --- Data source: private GitHub repo holding the seven CSVs -----------------
# The Data Hub "Fetch" button calls this backend, which pulls the requested
# CSV from this repo server-side. The token never reaches the browser.

# Format: "<github-username>/<repo-name>"
DATA_REPO=

# Branch to fetch from. Defaults to "main" if unset.
DATA_REPO_BRANCH=main

# Optional folder inside the repo (e.g. "csv" or "data/raw"). Leave empty if
# the files sit at the repo root.
DATA_REPO_SUBPATH=

# Fine-grained personal access token with read-only "Contents" permission on
# DATA_REPO only. Generate at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Optional: legacy Supabase config (not used in Phase 1) ------------------
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Report email (Resend) ---------------------------------------------------
# Powers "Download / Email Report" on the Dashboard. Free tier at resend.com
# covers this easily; the sandbox sender (onboarding@resend.dev) works with no
# domain verification needed until you want custom "from" branding.

# API key from your Resend account (Settings -> API Keys).
RESEND_API_KEY=

# Sender address. Leave unset to use the Resend sandbox sender.
NOTIFY_FROM_EMAIL=onboarding@resend.dev
