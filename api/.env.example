# Copy this file to api/.env and fill in the values.
# .env is gitignored — never commit secrets.

# --- Data source: private GitHub repo holding the seven CSVs -----------------
# The Data Hub "Fetch" button calls this backend, which pulls the requested
# CSV from this repo server-side. The token never reaches the browser.

# Format: "<github-username>/<repo-name>"
DATA_REPO=

# Branch to fetch from. Defaults to "main" if unset.
DATA_REPO_BRANCH=main

# Optional folder inside the repo (e.g. "csv" or "data/raw"). Leave empty if
# the files sit at the repo root.
DATA_REPO_SUBPATH=

# Fine-grained personal access token with read-only "Contents" permission on
# DATA_REPO only. Generate at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Optional: legacy Supabase config (not used in Phase 1) ------------------
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Report email (Resend) ---------------------------------------------------
# Powers "Download / Email Report" on the Dashboard. Free tier at resend.com
# covers this easily; the sandbox sender (onboarding@resend.dev) works with no
# domain verification needed until you want custom "from" branding.

# API key from your Resend account (Settings -> API Keys).
RESEND_API_KEY=

# Sender address. Leave unset to use the Resend sandbox sender.
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- Authentication ----------------------------------------------------------
# There is deliberately NO default account and NO default password: an
# unconfigured deployment has no users, and protected routes return 503 rather
# than letting anyone through.

# How much of the API needs a session:
#   protected (default)  writes, the report mailer, the AI audit log and the
#                        admin surfaces need a session; reads stay open.
#   strict               everything except /api/auth/* and /health needs one.
#                        This is the setting for a hospital deployment.
#   open                 no enforcement. Ignored unless DEMO_INSECURE=1 is also
#                        set, so a typo can never disable security.
AUTH_MODE=protected

# Accounts, as user:role:hash, separated by ";".
# Roles: admin, director, staff_manager, stock_manager, viewer
#        (plus legacy 'planner', kept so older config keeps working).
# Generate a hash without putting the password in your shell history:
#     cd api && .venv/bin/python -m core.auth hash
# Example (hash abbreviated):
#     AUTH_USERS=jon:admin:scrypt$32768$8$1$c2FsdA==$aGFzaA==
AUTH_USERS=

# Signs the session cookies. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset and a random secret is used per process, which logs everyone out
# on restart and breaks a second instance.
AUTH_SECRET=

# Comma-separated browser origins allowed to call the API. Production serves the
# frontend from this same process (same origin), so this is only needed for
# local development, where it defaults to the Vite and preview ports.
CORS_ORIGINS=

# Set to 1 ONLY when a proxy in front of this app overwrites X-Forwarded-For
# (Render does). Left unset, the header is ignored and rate limits key on the
# socket address — because a direct client can forge that header freely and
# would otherwise appear as unlimited distinct clients.
TRUST_PROXY=
